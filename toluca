<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Arriba el Toluca</title>

    <style>
        body {
            margin: 0;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: black;
        }

        .texto {
            color: red;
            font-size: 60px;
            font-weight: bold;
            font-family: Arial, sans-serif;
            animation: parpadear 1s infinite;
        }

        @keyframes parpadear {
            0%, 50% {
                opacity: 1;
            }
            51%, 100% {
                opacity: 0;
            }
        }
    </style>
</head>
<body>
    <div class="texto">ARRIBA EL TOLUCA</div>
</body>
</html>
